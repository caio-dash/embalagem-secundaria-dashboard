  const ctx = {
    Chart: { register: () => {} },
    console: { warn(){}, error(){}, log(){} },
    setSyncStatus: () => {},
    parsePeriodo: () => true, // função não-compartilhada (26 diferentes); stub mínimo só pra sortLotesCronologico (do core) não quebrar
    document: { getElementById: () => null }, // esconderSkeletonLoading (do core) só precisa não quebrar
    initDashboard: () => {},
    carregarKitLotesSupabase: () => {},
