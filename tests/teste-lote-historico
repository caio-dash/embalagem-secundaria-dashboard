// Testa o CÓDIGO REAL extraído dos dois HTMLs para o recurso de arquivamento
// em lotes_historico: (1) leitura — lotes + lotes_historico são somados ao
// carregar, sem perder dados de anos arquivados; (2) gravação — lotes normais
// vão para 'lotes', lotes marcados com _historico:true só vão para
// 'lotes_historico', e só quando é a conta administradora quem está logada.
const fs = require('fs');
const path = require('path');
const vm = require('vm');
const RAIZ = path.join(__dirname, '..');

const CORE = fs.readFileSync(path.join(RAIZ, 'dashboard-core.js'), 'utf-8');

function extrairTrecho(arquivo, inicioMarca, fimMarca) {
  const html = fs.readFileSync(path.join(RAIZ, arquivo), 'utf-8');
  const a = html.indexOf(inicioMarca);
  const b = html.indexOf(fimMarca, a);
  if (a < 0 || b < 0) throw new Error(`marcador não encontrado em ${arquivo}: "${(a<0?inicioMarca:fimMarca)}"`);
  return html.slice(a, b);
}

let falhas = 0;
function confere(nome, condicao, detalhe) {
  console.log((condicao ? '  ✓ ' : '  ✗ FALHOU: ') + nome + (condicao ? '' : '  → ' + JSON.stringify(detalhe)));
  if (!condicao) falhas++;
}

// ───────────────────────── 1) LEITURA — VISUALIZAÇÃO ─────────────────────────
